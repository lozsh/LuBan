# LubanAgent 环境变量样例
# 用法：cp app/config/.env.example .env —— 零修改即可用 SQLite + noop 观测起来（FakeLLM 兜底，不连任何外部服务）。
# 跑真实模型 / 生产部署时，按各分组注释填入。
# 加载优先级（见 lubanagent/config/settings.py）：真实环境变量 > .env.{LUBAN_ENV} > .env。

# ============================================================
# 运行环境与日志
# ============================================================
# 环境标识：dev / staging / prod。决定 .env.{env} 分层加载与缺省行为。缺省 dev，零配置可起。
LUBAN_ENV=dev
# 调试模式：true 打开详细日志。开发期可设 true，生产保持 false。
DEBUG=false
# 日志级别：INFO / WARNING / ERROR / DEBUG。
LOG_LEVEL=INFO
# 日志格式：console（人读）/ json（结构化，生产日志采集用）。
LOG_FORMAT=console
# 用户扩展扫描包（逗号分隔）：框架运行期动态导入这些包下的 @tool/@graph/@hook 装饰器。
# 缺省 app.tools,app.graphs；包不存在则跳过、不报错。自定义工具/图放这里。
EXTENSION_PACKAGES=app.tools,app.graphs

# ============================================================
# 数据库
# ============================================================
# 异步驱动 URL。缺省 SQLite（免安装，零配置可起）；生产改 MySQL。
#   SQLite: sqlite+aiosqlite:///./lubanagent.db
#   MySQL:  mysql+asyncmy://user:pass@host:3306/lubanagent
DATABASE_URL=sqlite+aiosqlite:///./lubanagent.db

# ============================================================
# 模型与大脑
# ============================================================
# 模型连接信息（供应商 / 地址 / 能力 / 成本）存数据库 ModelDefinition，不在此处，开发期由 `luban init` 种子落库（FakeLLM 兜底）；接真实模型时通过 API `PUT /v1/models` 写库或工作台管理。
# 本组只放厂商 API Key 占位——由 ModelDefinition.api_key_env 指向的环境变量名读取
# （见 lubanagent/model/openai_compat.py 的 PROVIDERS 表）。
# 开发期可留空（FakeLLM 兜底，零配置可起）；跑真实模型前填入对应厂商 Key。
# DeepSeek
DEEPSEEK_API_KEY=
# 阿里云通义 / Qwen（DashScope 兼容模式，注意变量名是 DASHSCOPE_API_KEY）
DASHSCOPE_API_KEY=
# 智谱 GLM（注意变量名是 ZHIPUAI_API_KEY）
ZHIPUAI_API_KEY=
# OpenAI 官方或任意 OpenAI 兼容服务（PROVIDERS 未预填，需在 ModelDefinition 显式指定 api_key_env=OPENAI_API_KEY）
OPENAI_API_KEY=

# ============================================================
# 观测后端
# ============================================================
# none=只用内部 DB（最轻量，零配置兜底）；langfuse=自部署 Langfuse（需配 LANGFUSE_*）；
# langsmith=LangSmith 云版（需配 LANGSMITH_*）。
# Trace 始终先写内部 DB（source of truth），外发是旁路、失败不阻断运行。
OBSERVABILITY_BACKEND=none
# --- Langfuse（OBSERVABILITY_BACKEND=langfuse 时填）---
# 自部署地址，如 http://localhost:3000（容器内走服务名 http://langfuse:3000）
LANGFUSE_HOST=
# 留空则降级 noop 观测，不阻断运行。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# --- LangSmith（OBSERVABILITY_BACKEND=langsmith 时填）---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ============================================================
# 业务系统
# ============================================================
# 外部业务系统基址（REST/SSE）。客服示例用 http://localhost:9100（mock-biz）。
# 留空则不接业务系统，核心独立运行。
BIZ_BASE_URL=

# ============================================================
# 鉴权
# ============================================================
# 是否开启接入鉴权。代码缺省 true；此处设 false 以便零配置即可调 API。
# 生产部署必须改 true，并设置下方 API_KEY。
AUTH_ENABLED=false
# 框架内置 ApiKeyAuthProvider 用的 Key（请求头 Authorization: Bearer <key>）。
# AUTH_ENABLED=true 时必填，否则所有请求被拒；开发期（AUTH_ENABLED=false）可留空走 anonymous。
API_KEY=
# 每分钟每 Key 请求上限（内存滑动窗口限流）。缺省 600。
RATE_LIMIT_PER_MINUTE=600

# ============================================================
# 渠道层（可选 / 商用）
# ============================================================
# 渠道层（F14 消息渠道接入 / F15 会话状态机 / F16 出站风控）属商用独立模块，开源版不含。
# 核心不依赖渠道层，仅留 ChannelConnector / SessionStateStore / OutputGuard 三个扩展点。
# 商用版（lubanagent-channels）安装后，其环境变量见该模块文档；此处不列占位。
